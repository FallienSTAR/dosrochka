# Токен бота от @BotFather
BOT_TOKEN=

# Кому бот отвечает (через запятую). Свой ID можно узнать командой /id в боте.
# Пусто — бот отвечает всем.
ALLOWED_USER_IDS=

# Локальный порт для страницы Mini App
PORT=8080

# Необязательно: свой постоянный HTTPS-адрес. Если указан, туннель Cloudflare не запускается.
WEBAPP_URL=

# Секрет для webhook облачного бота (Cloudflare Worker)
WEBHOOK_SECRET=
